# Dependencies and generated builds. Keep package-manager lockfiles in Git.
node_modules/
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
.cache/
.turbo/

# Secrets: templates must contain placeholders only.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Runtime data and local databases. Keep migrations and seed code in Git.
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
cms/media/
cms/uploads/
backups/

# Local browser state and generated verification artifacts.
browser-profile/
chrome-*-profile/
.playwright-cli/
test-results/
playwright-report/
artifacts/
*.log
npm-debug.log*
pnpm-debug.log*

# Machine-specific tooling and editor files.
.agents/
.codex/
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.tmp

# Intentionally tracked: design-concept/assets/, design-concept/review/, docs/.
